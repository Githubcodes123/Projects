def stopwatch(current_time, player):
    current_time -= player.offset
    minutes = int(current_time / 60000 % 24)
    seconds = int(current_time / 1000 % 60)
    milliseconds = current_time % 1000
    out = "player {player}: {points} {minutes:02d}:{seconds:02d}:{milliseconds:03d}".format(player = players.index(player) + 1, points = round(player.points,2),minutes=minutes,seconds=seconds,milliseconds=milliseconds)
    text_width, text_height = textfont.size(out)
    return out, text_width, text_height
def ai():
    # random movement
    #returns possible movements: up, left, right, down
    possible_movements = ["up", "down", "left", "right"]
    return random.choice(possible_movements)
def updatepoints(player):
    # to incentivise time
    time_penalty = player.time_alive / 1000 
    # distence from top of player to winbox
    dist_points = SCREEN_HEIGHT - player.centre()[1]
    player.points = dist_points - time_penalty
spawn_obstacles(obstacle_number, obstacles)
while running:
    # poll for events
    # pygame.QUIT event means the user clicked X to close your window
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # player movement
    for player in players:
        if player.alive == True:
            move = ai()
            match move:
                case "up":
                    player.move_up()
                case "down":
                    player.move_down()        
                case "left":
                    player.move_left()
                case "right":
                    player.move_right() 
    # fill the screen with a color to wipe away anything from last frame
    screen.fill("purple")

    # RENDER YOUR GAME HERE
    for player in players:
        pygame.draw.rect(screen,"blue",player.body)
    # render vision rays + circle
    for player in players:
        for a in range(ray_count):
            angle = a * ((2*m.pi)/ray_count)
            # draws a ray from centre of player to angle "a" 100 pixels away
            ray = pygame.draw.line(screen, "white", player.centre(),(player.centre()[0] + 100*m.sin(angle),player.centre()[1] - 100*m.cos(angle)))
            for obstacle in obstacles:
                if obstacle.clipline((player.centre(),(player.centre()[0] + 100*m.sin(angle),player.centre()[1] - 100*m.cos(angle)))):
                    distence_from_obstacle = m.dist(player.centre(),obstacle.clipline((player.centre(),(player.centre()[0] + 100*m.sin(angle),player.centre()[1] - 100*m.cos(angle))))[0]) - ((player_size/2)/m.cos(angle))
                    player.hit_rays.append((angle, distence_from_obstacle))
                    pygame.draw.line(screen, "red", player.centre(),(player.centre()[0] + 100*m.sin(angle),player.centre()[1] - 100*m.cos(angle)))
        pygame.draw.circle(screen,"orange",player.centre(),100,width = 1)

        
    # draw objects
    pygame.draw.rect(screen,"yellow",winbox)
    for obstacle in obstacles:
        pygame.draw.rect(screen, "green", obstacle)
    # draw text
    screen.blit(textfont.render(f"generation: {generation}",False,"black"),(SCREEN_WIDTH-textfont.size(f"generation: {generation}")[0],25))
    screen.blit(textfont.render(f"fps: {round(clock.get_fps(),2)}",False,"black"),(SCREEN_WIDTH-textfont.size((f"fps: {round(clock.get_fps(),2)}"))[0],55))
    for player in players:
            player.time_alive = pygame.time.get_ticks()
            txt, txt_width, txt_height = stopwatch(pygame.time.get_ticks(), player)
            screen.blit(textfont.render(txt,False,"black"),(SCREEN_WIDTH-txt_width,85+player.index * 30))           
            if player.win == True:
                txt, txt_width, txt_height = stopwatch(player.time_alive, player)
                screen.blit(textfont.render(txt,False,"green"),(SCREEN_WIDTH-txt_width,85+player.index * 30))     
            elif player.body.collidelist(obstacles) >= 0:
                txt, txt_width, txt_height = stopwatch(player.time_alive, player)
                screen.blit(textfont.render(txt,False,"red"),(SCREEN_WIDTH-txt_width,85+player.index * 30))
    # flip() the display to put your work on screen
    pygame.display.flip()
    # update points
    for player in players:
        if player.alive == True:
            updatepoints(player)
    # win/lose check
    for player in players:
        if player.body.collidelist(obstacles) >= 0:
            gameover(player)
        if player.body.colliderect(winbox):
            win(player)
        player.hit_rays.clear()
    clock.tick(60)  # limits FPS to 60

pygame.quit()