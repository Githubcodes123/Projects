def updatepoints(player):
    # to incentivise time
    time_penalty = player.time_alive / 1000
    # distence from top of player to winbox
    dist_points = SCREEN_HEIGHT - player.centre()[1]
    player.points = round(dist_points - time_penalty,3)
    # player.points = dist_points
def update_player_brains(players_sorted_by_points):

    bestplayer = players_sorted_by_points[0]
    runnerupplayer = players_sorted_by_points[1]
    # make all players the average of the 2 best players +- mutation_strength%
    for player in players:
        new_base_up = ((bestplayer.probs["up"] + runnerupplayer.probs["up"])/2) * random.uniform(1 - mutation_strength,1 + mutation_strength)
        new_base_down = ((bestplayer.probs["down"] +runnerupplayer.probs["down"])/2) * random.uniform(1 - mutation_strength,1 + mutation_strength)
        new_base_left = ((bestplayer.probs["left"]+runnerupplayer.probs["left"])/2) * random.uniform(1 - mutation_strength,1 + mutation_strength)
        new_base_right = ((bestplayer.probs["right"] + runnerupplayer.probs["right"])/2) * random.uniform(1 - mutation_strength,1 + mutation_strength)
        new_base_sum = new_base_up + new_base_down + new_base_left + new_base_right

        player.probs = {
             "up": new_base_up / new_base_sum,
             "down": new_base_down / new_base_sum,
             "left": new_base_left / new_base_sum,
             "right": new_base_right / new_base_sum
        }

