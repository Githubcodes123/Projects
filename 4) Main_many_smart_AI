def stopwatch(current_time, player):
    current_time -= player.offset
    minutes = int(current_time / 60000 % 24)
    seconds = int(current_time / 1000 % 60)
    milliseconds = current_time % 1000
    out = "player {player}: {points} {minutes:02d}:{seconds:02d}:{milliseconds:03d}".format(player = players.index(player) + 1, points = round(player.points,2),minutes=minutes,seconds=seconds,milliseconds=milliseconds)
    text_width, text_height = textfont.size(out)
    return out, text_width, text_height
def ai(player):
    # random movement
    #returns possible movements: up, left, right, down
    possible_movements = ["up", "down", "left", "right"]
    weights = [player.probs["up"],player.probs["down"],player.probs["left"],player.probs["right"]]
    return random.choices(possible_movements,weights)[0]
