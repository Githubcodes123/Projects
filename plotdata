import matplotlib.pyplot as plt
import numpy as np
# plot settings
plt.xlabel('generation')
plt.ylabel('score')
# import the data
data = open("data.txt","r").read()
parsed_data = [float(x) for x in data.split(",")]
# get number of players and remove first number
numofplayers = int(parsed_data.pop(0))
generation_count = int(data.count(".")/numofplayers)


def plot_all_players(numofplayers):
    x_coords = []
    # create a list with numofplayers copies of generation number up to generation number in data 
    for a in range(generation_count):
        x_coords.extend([a + 1] * numofplayers)
    y_coords = parsed_data

    m, c = np.polyfit(x_coords, y_coords, deg=1)
    print(f"y = {m} x + {c}")


    plt.scatter(x_coords,y_coords)

    xseq = np.linspace(0, generation_count, num=100)

    plt.plot(xseq, c + m * xseq, color="k", lw=2.5)
def plot_top_player(numofplayers):
    x_coords = []
    # create a list with numofplayers copies of generation number up to generation number in data 
    for a in range(generation_count):
        x_coords.extend([a + 1])
    y_coords = parsed_data[::numofplayers]

    m, c = np.polyfit(x_coords, y_coords, deg=1)
    print(f"y = {m} x + {c}")


    plt.scatter(x_coords,y_coords)

    xseq = np.linspace(0, generation_count, num=100)

    plt.plot(xseq, c + m * xseq, color="k", lw=2.5)
def plot_average_player(numofplayers):
    x_coords = []
    # create a list with numofplayers copies of generation number up to generation number in data 
    for a in range(generation_count):
        x_coords.extend([a + 1])
    y_coords = [sum(parsed_data[i:i+numofplayers])//numofplayers for i in range(0,len(parsed_data),numofplayers)]


    m, c = np.polyfit(x_coords, y_coords, deg=1)
    print(f"y = {m} x + {c}")


    plt.scatter(x_coords,y_coords)

    xseq = np.linspace(0, generation_count, num=100)

    plt.plot(xseq, c + m * xseq, color="k", lw=2.5)


