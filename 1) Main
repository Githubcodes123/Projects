import pygame
import random
import math as m
# pygame setup
SCREEN_WIDTH = 1280
SCREEN_HEIGHT = 720

pygame.init()
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
clock = pygame.time.Clock()
running = True
has_moved = False
obstacles = []
obstacle_number = 100
game = 1
winbox = pygame.Rect(0, 0,SCREEN_WIDTH,25)

player_size = 25
player = pygame.Rect(SCREEN_WIDTH/2, SCREEN_HEIGHT-player_size,player_size,player_size)
player_centre = (player.x + player_size/2, player.y + player_size/2)

hit_rays = []
ray_count = 24

timer = pygame.time.Clock()
textfont = pygame.font.SysFont("Comic Sans MS", 30)

offset = 0
def spawn_obstacles(numbertospawn, list):
    list.clear()
    for _ in range(numbertospawn):
        obstacle_rect = pygame.Rect(random.randint(0,SCREEN_WIDTH - 25), random.randint(100,SCREEN_HEIGHT-75),25,25)
        list.append(obstacle_rect)
    leftwall = pygame.Rect(-25, 0,25,SCREEN_HEIGHT)
    list.append(leftwall)
    rightwall = pygame.Rect(SCREEN_WIDTH, 0,25,SCREEN_HEIGHT)
    list.append(rightwall)
    bottomwall = pygame.Rect(0, SCREEN_HEIGHT,SCREEN_WIDTH,25)
    list.append(bottomwall)
def restart():
    global has_moved, game
    has_moved = False
    spawn_obstacles(obstacle_number, obstacles)
    player.x = SCREEN_WIDTH/2
    player.y = SCREEN_HEIGHT-25
    game += 1
def gameover():
    print("gameover")
    restart()
def win():
    txt = stopwatch(pygame.time.get_ticks(), offset)[0]
    print("win!",txt)
    restart()


def stopwatch(current_time, offset):
    current_time -= offset
    minutes = int(current_time / 60000 % 24)
    seconds = int(current_time / 1000 % 60)
    milliseconds = current_time % 1000
    out = "{minutes:02d}:{seconds:02d}:{milliseconds:03d}".format(minutes=minutes,seconds=seconds,milliseconds=milliseconds)
    text_width, text_height = textfont.size(out)
    return out, text_width, text_height

spawn_obstacles(obstacle_number, obstacles)
while running:
    # poll for events
    # pygame.QUIT event means the user clicked X to close your window
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # player movement
    keys = pygame.key.get_pressed()
    if keys[pygame.K_w]:
         if has_moved == False:
            has_moved = True
            offset = pygame.time.get_ticks()
         player.y -= 10
    if keys[pygame.K_s]:
         if has_moved == False:
            has_moved = True
            offset = pygame.time.get_ticks()
         player.y += 10         
    if keys[pygame.K_a]:
         if has_moved == False:
            has_moved = True
         player.x -= 10
    if keys[pygame.K_d]:
         if has_moved == False:
            has_moved = True
            offset = pygame.time.get_ticks()
         player.x += 10
    
    player_centre = (player.x + player_size/2, player.y + player_size/2)
    # fill the screen with a color to wipe away anything from last frame
    screen.fill("purple")

    # RENDER YOUR GAME HERE
    pygame.draw.rect(screen,"blue",player)
    # render vision rays 
    for a in range(ray_count):
        angle = a * ((2*m.pi)/ray_count)
        # draws a ray from centre of player to angle "a" 100 pixels away
        ray = pygame.draw.line(screen, "white", player_centre,(player_centre[0] + 100*m.sin(angle),player_centre[1] - 100*m.cos(angle)))
        for obstacle in obstacles:
            if obstacle.clipline((player_centre,(player_centre[0] + 100*m.sin(angle),player_centre[1] - 100*m.cos(angle)))):
                distence_from_obstacle = m.dist(player_centre,obstacle.clipline((player_centre,(player_centre[0] + 100*m.sin(angle),player_centre[1] - 100*m.cos(angle))))[0]) - ((player_size/2)/m.cos(angle))
                hit_rays.append((angle, distence_from_obstacle))
                pygame.draw.line(screen, "red", player_centre,(player_centre[0] + 100*m.sin(angle),player_centre[1] - 100*m.cos(angle)))

        

    pygame.draw.circle(screen,"orange",player_centre,100,width = 1)
    pygame.draw.rect(screen,"yellow",winbox)
    if has_moved == True:
        txt, txt_width, txt_height = stopwatch(pygame.time.get_ticks(), offset)
        screen.blit(textfont.render(txt,False,"black"),(SCREEN_WIDTH-txt_width,25))
    for obstacle in obstacles:
        pygame.draw.rect(screen, "green", obstacle)
    if player.collidelist(obstacles) >= 0:
        gameover()
    if player.colliderect(winbox):
        win()
    screen.blit(textfont.render(f"game: {game}",False,"black"),(SCREEN_WIDTH-textfont.size(f"game: {game}")[0],50))
    screen.blit(textfont.render(f"fps: {round(clock.get_fps(),2)}",False,"black"),(SCREEN_WIDTH-textfont.size((f"fps: {round(clock.get_fps(),2)}"))[0],80))
    # flip() the display to put your work on screen
    pygame.display.flip()
    print(hit_rays)
    hit_rays.clear()
    clock.tick(60)  # limits FPS to 60

pygame.quit()